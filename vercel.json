{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/proxy?__subpath=:match*"
    },
    {
      "source": "/api",
      "destination": "/api/proxy"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
